# Copy this file to .env and fill in real values. NEVER commit the real .env file.

# LLM provider selection. Currently only "gemini" is implemented; any other
# value (or gemini_unreachable) makes the app fall back to deterministic
# heuristics everywhere an LLM would otherwise be called - see
# integrations/llm/gemini.py.
LLM_PROVIDER=gemini

# Required for the agent's LLM reasoning + embeddings. Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY is kept as a fallback alias for LLM_API_KEY (backend/core/config.py) -
# set either name, LLM_API_KEY takes precedence if both are set.
LLM_API_KEY=
GEMINI_API_KEY=

# Optional: leave unset to run in mock payment mode (fully demoable without a
# Razorpay account). Set both to enable real Razorpay TEST MODE Orders/Payments/
# Refunds API calls.
# Get test keys (prefixed rzp_test_) from the Razorpay Dashboard > Settings > API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook Secret - set in the Razorpay Dashboard when you create a webhook
# (Settings > Webhooks), NOT the same value as RAZORPAY_KEY_SECRET. Required
# for /api/webhook/razorpay to verify the X-Razorpay-Signature header. See
# README "Webhook configuration" for the local-tunnel vs live setup.
RAZORPAY_WEBHOOK_SECRET=

# Explicit payment provider selection - the app will NOT silently fall back
# from Razorpay to mock mode. Set to `razorpay_test` for the real demo (fails
# loudly at call time if the keys above aren't set); `mock` to force offline
# dev even if keys are present; leave unset to infer from key presence
# (same behavior as before this flag existed).
PAYMENT_PROVIDER=

# SQLite by default - see backend/core/config.py / repositories/db.py. No
# Postgres/Redis/Kafka/vector DB is required or used by this project.
DATABASE_URL=sqlite:///./backend/quickbite.db
